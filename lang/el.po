msgstr "Ενημερωμένο."

#: src/app/Main.cpp
msgid "Not checked yet."
msgstr "Δεν έχει ελεγχθεί ακόμα."

#: src/app/Main.cpp
msgid "Check for updates at start"
msgstr "Έλεγχος για ενημερώσεις στην εκκίνηση"

#: src/app/Main.cpp
msgid "Looks at github.com/leskal/AnyPS5-Launcher/releases and downloads a new version in the background."
msgstr "Κοιτάζει το github.com/leskal/AnyPS5-Launcher/releases και κατεβάζει νέα έκδοση στο παρασκήνιο."

#: src/app/Main.cpp
msgid "Links"
msgstr "Σύνδεσμοι"

#: src/app/Main.cpp
msgid "Links like anyps5://play/PPSA01234 start a game from anywhere: a shortcut, a browser, another app. Copy link is in a game's actions."
msgstr "Σύνδεσμοι όπως anyps5://play/PPSA01234 ξεκινούν ένα παιχνίδι από οπουδήποτε: συντόμευση, browser, άλλη εφαρμογή. Η Αντιγραφή συνδέσμου είναι στις ενέργειες κάθε παιχνιδιού."

#: src/app/Main.cpp
msgid "Changes take effect when you save."
msgstr "Οι αλλαγές ισχύουν μετά την αποθήκευση."

#, c-format
#: src/app/Main.cpp
msgid "Saved in %s"
msgstr "Αποθηκεύεται στο %s"

