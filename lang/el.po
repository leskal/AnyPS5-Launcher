#: src/core/Diagnosis.cpp
msgid "You stopped the game"
msgstr "Σταματήσατε το παιχνίδι"

#: src/core/Diagnosis.cpp
msgid "Needs a system function AnyPS5 doesn't have yet"
msgstr "Χρειάζεται λειτουργία συστήματος που δεν έχει ακόμα το AnyPS5"

#: src/core/Diagnosis.cpp
msgid "Nothing to fix on your side: the game needs a newer AnyPS5. Make a report to share it."
msgstr "Δεν χρειάζεται να διορθώσετε κάτι: το παιχνίδι θέλει νεότερο AnyPS5. Δημιουργήστε αναφορά για να το μοιραστείτε."

#: src/core/Diagnosis.cpp
msgid "Uses graphics AnyPS5 can't draw yet"
msgstr "Χρησιμοποιεί γραφικά που το AnyPS5 δεν σχεδιάζει ακόμα"

#: src/core/Diagnosis.cpp
msgid "The game needs a newer AnyPS5. Make a report to share it."
msgstr "Το παιχνίδι θέλει νεότερο AnyPS5. Δημιουργήστε αναφορά για να το μοιραστείτε."

#: src/core/Diagnosis.cpp
msgid "Stopped on an engine error"
msgstr "Σταμάτησε σε σφάλμα της μηχανής"

#: src/core/Diagnosis.cpp
msgid "Closed normally"
msgstr "Έκλεισε κανονικά"

#: src/core/Diagnosis.cpp
msgid "A module is missing"
msgstr "Λείπει ένα module"

#: src/core/Diagnosis.cpp
msgid "Reinstall the game. If it stays, AnyPS5 doesn't provide this module yet."
msgstr "Επανεγκαταστήστε το παιχνίδι. Αν συνεχίσει, το AnyPS5 δεν έχει ακόμα αυτό το module."

#: src/core/Diagnosis.cpp
msgid "The GPU ran out of memory"
msgstr "Η κάρτα γραφικών έμεινε χωρίς μνήμη"

#: src/core/Diagnosis.cpp
msgid "Close other programs that use the GPU, or lower the game's own graphics settings."
msgstr "Κλείστε άλλα προγράμματα που χρησιμοποιούν την κάρτα γραφικών, ή χαμηλώστε τις ρυθμίσεις γραφικών του παιχνιδιού."

#: src/core/Diagnosis.cpp
msgid "The GPU stopped"
msgstr "Η κάρτα γραφικών σταμάτησε"

#: src/core/Diagnosis.cpp
msgid "Update the graphics driver. If it keeps happening at the same place, make a report."
msgstr "Ενημερώστε τον οδηγό της κάρτας γραφικών. Αν συμβαίνει στο ίδιο σημείο, δημιουργήστε αναφορά."

#: src/core/Diagnosis.cpp
msgid "The system ran out of memory"
msgstr "Το σύστημα έμεινε χωρίς μνήμη"

#: src/core/Diagnosis.cpp
msgid "Close other programs, or let Windows grow the page file (System > About > Advanced system settings)."
msgstr "Κλείστε άλλα προγράμματα, ή αφήστε τα Windows να μεγαλώσουν το αρχείο σελιδοποίησης (Σύστημα > Πληροφορίες > Ρυθμίσεις συστήματος για προχωρημένους)."

#: src/core/Diagnosis.cpp
msgid "The crash is in NVIDIA's shader compiler: update the graphics driver."
msgstr "Η κατάρρευση είναι στον μεταγλωττιστή shader της NVIDIA: ενημερώστε τον οδηγό της κάρτας γραφικών."

#: src/core/Diagnosis.cpp
msgid "Stopped on an error"
msgstr "Σταμάτησε σε σφάλμα"

#: src/core/Diagnosis.cpp
msgid "Ended"
msgstr "Τελείωσε"

#: src/core/Diagnosis.cpp
msgid "Closed"
msgstr "Έκλεισε"

