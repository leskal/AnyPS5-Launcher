msgid "Screenshot"
msgstr "Στιγμιότυπο"

#: src/core/InputMapping.cpp
msgid "Controller status"
msgstr "Κατάσταση χειριστηρίου"

#: src/core/InputMapping.cpp
msgid "Volume down"
msgstr "Ένταση κάτω"

#: src/core/InputMapping.cpp
msgid "Volume up"
msgstr "Ένταση πάνω"

#: src/core/InputMapping.cpp
msgid "Mute"
msgstr "Σίγαση"

#: src/core/InputMapping.cpp
msgid "Reload these controls"
msgstr "Επαναφόρτωση χειρισμών"

#: src/core/InputMapping.cpp
msgid "Left stick dead zone (%)"
msgstr "Νεκρή ζώνη αριστερού μοχλού (%)"

#: src/core/InputMapping.cpp
msgid "How much of a controller stick's travel reads as centered. Raise it for a drifting stick."
msgstr "Πόση από τη διαδρομή του μοχλού διαβάζεται ως κέντρο. Αυξήστε τη για μοχλό που ολισθαίνει."

#: src/core/InputMapping.cpp
msgid "Right stick dead zone (%)"
msgstr "Νεκρή ζώνη δεξιού μοχλού (%)"

#: src/core/InputMapping.cpp
msgid "The same for the right stick."
msgstr "Το ίδιο για τον δεξιό μοχλό."

#: src/core/InputMapping.cpp
msgid "Mouse sensitivity"
msgstr "Ευαισθησία ποντικιού"

#: src/core/InputMapping.cpp
msgid "How fast the mouse turns the stick while \"Mouse moves the stick\" is on."
msgstr "Πόσο γρήγορα το ποντίκι γυρίζει τον μοχλό όσο είναι ενεργό το \"Το ποντίκι κινεί τον μοχλό\"."

#: src/core/InputMapping.cpp
msgid "Mouse vertical speed"
msgstr "Κατακόρυφη ταχύτητα ποντικιού"

#: src/core/InputMapping.cpp
msgid "Multiplies up and down mouse movement, for games that pitch slower or faster than they turn."
msgstr "Πολλαπλασιάζει την πάνω-κάτω κίνηση του ποντικιού, για παιχνίδια που κοιτάζουν πάνω-κάτω πιο αργά ή πιο γρήγορα απ' ό,τι γυρίζουν."

#: src/core/InputMapping.cpp
msgid "Mouse response curve"
msgstr "Καμπύλη απόκρισης ποντικιού"

#: src/core/InputMapping.cpp
msgid "Above 1 gives finer control at low speed; below 1 reaches large tilts sooner."
msgstr "Πάνω από 1 δίνει πιο λεπτό έλεγχο σε χαμηλή ταχύτητα· κάτω από 1 φτάνει νωρίτερα σε μεγάλες κλίσεις."

#: src/core/InputMapping.cpp
msgid "Mouse minimum tilt"
msgstr "Ελάχιστη κλίση ποντικιού"

#: src/core/InputMapping.cpp
msgid "The smallest tilt any mouse movement gives. Set it just above the game's own dead zone."
msgstr "Η μικρότερη κλίση που δίνει οποιαδήποτε κίνηση του ποντικιού. Βάλτε τη λίγο πάνω από τη νεκρή ζώνη του ίδιου του παιχνιδιού."

#: src/core/InputMapping.cpp
msgid "Mouse maximum speed"
msgstr "Μέγιστη ταχύτητα ποντικιού"

#: src/core/InputMapping.cpp
msgid "The fastest tracked speed, as a multiple of full tilt."
msgstr "Η μεγαλύτερη ταχύτητα που μετριέται, ως πολλαπλάσιο της πλήρους κλίσης."

#: src/core/InputMapping.cpp
msgid "Mouse smoothing (ms)"
msgstr "Εξομάλυνση ποντικιού (ms)"

#: src/core/InputMapping.cpp
msgid "0 follows every mouse report directly."
msgstr "Το 0 ακολουθεί απευθείας κάθε κίνηση του ποντικιού."

#: src/core/InputMapping.cpp
msgid "Mouse stop delay (ms)"
msgstr "Καθυστέρηση στάσης ποντικιού (ms)"

#: src/core/InputMapping.cpp
msgid "How soon the stick centers after the mouse stops."
msgstr "Πόσο σύντομα κεντράρει ο μοχλός όταν σταματήσει το ποντίκι."

#: src/core/InputMapping.cpp
msgid "Mouse drives"
msgstr "Το ποντίκι κινεί"

#: src/core/InputMapping.cpp
msgid "Which stick the mouse moves."
msgstr "Ποιον μοχλό κινεί το ποντίκι."

#: src/core/InputMapping.cpp
msgid "Slow stick tilt"
msgstr "Κλίση αργού μοχλού"

#: src/core/InputMapping.cpp
msgid "How far keyboard stick keys tilt while \"Slow stick\" is held."
msgstr "Πόσο γέρνουν τα πλήκτρα μοχλού όσο κρατιέται το \"Αργός μοχλός\"."

#: src/core/InputMapping.cpp
msgid "Keyboard stick ramp (ms)"
msgstr "Σταδιακή κλίση μοχλού από πλήκτρα (ms)"

#: src/core/InputMapping.cpp
msgid "How long a key takes to tilt a stick fully. 0 tilts at once."
msgstr "Πόση ώρα χρειάζεται ένα πλήκτρο για να γείρει πλήρως τον μοχλό. Το 0 τον γέρνει αμέσως."

#: src/core/InputMapping.cpp
msgid "Trigger ramp (ms)"
msgstr "Σταδιακή σκανδάλη (ms)"

#: src/core/InputMapping.cpp
msgid "How long a key takes to press L2 or R2 fully, for racing games."
msgstr "Πόση ώρα χρειάζεται ένα πλήκτρο για να πατήσει πλήρως το L2 ή το R2, για παιχνίδια αγώνων."

